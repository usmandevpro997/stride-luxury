function App() {
  const [cart, setCart] = useState([])
  const [notice, setNotice] = useState('')

  const addToCart = (product) => {
    setCart((curr) => {
      const found = curr.find((p) => p.id === product.id)
      if (found) {
        return curr.map((p) => (p.id === product.id ? { ...p, quantity: p.quantity + 1 } : p))
      }
      return [...curr, { ...product, quantity: 1 }]
    })
    setNotice(`${product.name} added to bag`)
    window.setTimeout(() => setNotice(''), 2800)
  }

  const cartCount = cart.reduce((sum, p) => sum + p.quantity, 0)

  return (
    <BrowserRouter>
      <div className="aurel-app">
        <Navbar cartCount={cartCount} />
        {notice && (
          <div className="aurel-toast" role="status" aria-live="polite">
            {notice}
          </div>
        )}
        <Routes>
          <Route path="/" element={<Home products={productsData.slice(0,3)} onAddToBag={addToCart} />} />
          <Route path="/shop" element={<Shop products={productsData} onAddToBag={addToCart} />} />
        </Routes>
        <Footer />
      </div>
    </BrowserRouter>
  )
}

export default App
